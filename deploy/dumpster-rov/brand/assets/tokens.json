{
  "$description": "Dumpster design tokens v2 (after dark). Mirrors tokens.css. Source of truth: PLAN.md section 3.",
  "color": {
    "dark": {
      "void": "#070707",
      "ink": "#0E0E0F",
      "graphite": "#17181A",
      "smoke": "#24262A",
      "ash": "#8B8F94",
      "bone": "#EEEEEC",
      "paper": "#F4F1EC",
      "line": "rgba(238,238,236,.12)",
      "lineStrong": "rgba(238,238,236,.24)",
      "dim": "rgba(238,238,236,.52)"
    },
    "paper": {
      "void": "#F4F1EC",
      "ink": "#ECE8E1",
      "graphite": "#E4DFD7",
      "smoke": "#D9D3C9",
      "ash": "#6B6F74",
      "bone": "#0E0E0F",
      "paper": "#F4F1EC",
      "line": "rgba(14,14,15,.12)",
      "lineStrong": "rgba(14,14,15,.24)",
      "dim": "rgba(14,14,15,.56)"
    },
    "sent": "#2B5CFF",
    "sentPress": "#2149D6",
    "sentText": "#FFFFFF",
    "danger": "#E5484D",
    "$rule": "Blue (sent) appears only on messages the user sends and the send flight. Never on UI chrome."
  },
  "radius": { "xs": 4, "sm": 10, "md": 16, "lg": 24, "pill": 999, "bubble": "16px 16px 4px 16px" },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "font": {
    "display": "\"Space Grotesk\", system-ui, sans-serif",
    "body": "\"Geist\", system-ui, sans-serif",
    "mono": "\"Geist Mono\", ui-monospace, monospace",
    "google": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600&family=Geist:wght@300;400;500&family=Geist+Mono:wght@400&display=swap"
  },
  "type": {
    "display": { "size": 64, "line": 64, "weight": 300, "tracking": "-0.03em", "family": "display" },
    "h1": { "size": 40, "line": 44, "weight": 400, "tracking": "-0.02em", "family": "display" },
    "h2": { "size": 28, "line": 32, "weight": 400, "tracking": "-0.02em", "family": "display" },
    "h3": { "size": 18, "line": 24, "weight": 500, "tracking": "-0.01em", "family": "display" },
    "body": { "size": 16, "line": 24, "weight": 300, "family": "body" },
    "small": { "size": 14, "line": 20, "weight": 300, "family": "body" },
    "label": { "size": 11.5, "weight": 400, "tracking": "0.32em", "transform": "uppercase", "family": "display" },
    "meta": { "size": 12, "weight": 400, "family": "mono" },
    "wordmark": { "family": "display", "weight": 500, "tracking": "0.064em", "transform": "uppercase", "note": "Shipped as outlined paths in wordmark.svg" }
  },
  "motion": {
    "easeOut": "cubic-bezier(.2,.8,.2,1)",
    "easeDrop": "cubic-bezier(.55,0,.8,.3)",
    "fadeMs": 300,
    "slowMs": 600,
    "driftSeconds": 18,
    "send": { "lidOpenMs": 260, "dropMs": 640, "lidShutMs": 300, "glintMs": 900, "filedFadeMs": 500, "lidOpenDeg": -30 }
  },
  "light": {
    "dark": { "a": "rgba(222,228,233,.06)", "b": "rgba(176,183,189,.035)", "c": "rgba(204,210,214,.03)", "grainOpacity": 0.07 },
    "paper": { "a": "rgba(255,255,255,.55)", "b": "rgba(255,255,255,.3)", "c": "rgba(255,255,255,.25)", "grainOpacity": 0.06 },
    "recipe": "void + 3 radial gradients (54% 12%, 18% 60%, 82% 82%) + feTurbulence grain overlay, mix-blend-mode overlay"
  },
  "logo": {
    "grid": 64,
    "markBounds": { "x": [5.5, 58.5], "y": [11, 52.6] },
    "strokeUnitsBySize": {
      "200": { "units": 0.64, "px": 2.0, "variant": "mark" },
      "64": { "units": 1.8, "px": 1.8, "variant": "mark" },
      "32": { "units": 3, "px": 1.5, "variant": "mark" },
      "24": { "units": 4, "px": 1.5, "variant": "mark-small" },
      "16": { "units": 5, "px": 1.25, "variant": "mark-small" }
    },
    "minSizePx": 16,
    "clearSpace": "Half the mark height (x) on every side; one lid height (6u) minimum inside lockups"
  },
  "icons": { "grid": 24, "stroke": 1.5, "caps": "round", "joins": "round", "color": "currentColor" },
  "touchTarget": 44
}
